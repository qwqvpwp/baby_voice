<!-- 主页面 - 录音识别 -->
<view class="container">
  <!-- 顶部标题 -->
  <view class="title-section">
    <text class="title">{{t.title}}</text>
    <text class="subtitle">{{t.subtitle}}</text>
  </view>

  <!-- 录音区域 -->
  <view class="card" style="display: flex; flex-direction: column; align-items: center;">
    <view class="record-btn {{isRecording ? 'recording' : ''}}" bindtap="toggleRecord">
      <view wx:if="{{!isRecording}}" class="record-icon"></view>
      <text wx:else style="color: #FFF; font-size: 48rpx; font-weight: bold;">■</text>
    </view>
    <text wx:if="{{!isRecording}}" style="color: #999; margin-top: 24rpx; font-size: 28rpx;">
      {{t.tapToRecord}}
    </text>
    <text wx:if="{{isRecording}}" style="color: #FF4444; margin-top: 24rpx; font-size: 28rpx;">
      {{t.recording}} {{recordingTime}}s
    </text>

    <!-- 重新录音按钮 -->
    <button wx:if="{{hasRecorded && !isRecording}}" class="btn-secondary" style="margin-top: 24rpx;"
            bindtap="reRecord" size="mini">
      {{t.reRecord}}
    </button>

    <!-- 上传音频入口 -->
    <view wx:if="{{!isRecording && !hasRecorded}}" class="upload-section">
      <view class="upload-divider">
        <view class="divider-line"></view>
        <text class="divider-text">{{t.or}}</text>
        <view class="divider-line"></view>
      </view>
      <view class="upload-btns">
        <view class="upload-btn" bindtap="chooseFromChat">
          <text class="upload-icon">📎</text>
          <text class="upload-label">{{t.pickFromChat}}</text>
        </view>
        <view class="upload-btn" bindtap="chooseFromFile">
          <text class="upload-icon">📁</text>
          <text class="upload-label">{{t.pickFromFile}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 分析中提示 -->
  <view wx:if="{{isAnalyzing}}" class="card" style="text-align: center;">
    <text style="color: #FF6B81; font-size: 30rpx;">{{t.analyzing}}</text>
    <view style="margin-top: 16rpx;">
      <text class="dot">●</text>
      <text class="dot">●</text>
      <text class="dot">●</text>
    </view>
  </view>

  <!-- 识别结果 -->
  <view wx:if="{{result}}" class="card">
    <!-- 主要情绪 -->
    <view class="emotion-hero">
      <text class="emotion-emoji">{{resultEmoji}}</text>
      <view class="emotion-name">{{resultEmotion}}</view>
      <text class="emotion-confidence">{{t.confidence}} {{resultConfidence}}%</text>
      <view class="model-tag">{{modelLabel}}</view>
    </view>

    <!-- 建议 -->
    <view wx:if="{{suggestion}}" class="emotion-suggestion">
      <text>💡 {{suggestion}}</text>
    </view>

    <!-- 全部情绪概率 -->
    <view style="margin-top: 30rpx;">
      <text style="font-size: 28rpx; color: #999; margin-bottom: 16rpx; display: block;">{{t.allProbabilities}}</text>
      <view wx:for="{{result.probabilities}}" wx:key="class" class="prob-bar">
        <text class="prob-label">{{item.cn}}</text>
        <view class="prob-track">
          <view class="prob-fill" style="width: {{item.barWidth}}%; background: {{item.barColor}};"></view>
        </view>
        <text style="width: 80rpx; font-size: 22rpx; color: #999; margin-left: 10rpx;">
          {{item.probPercent}}%
        </text>
      </view>
    </view>
  </view>

  <!-- 错误提示 -->
  <view wx:if="{{errorMsg}}" class="card" style="background: #FFF0F0;">
    <text style="color: #FF4444; font-size: 28rpx;">{{errorMsg}}</text>
  </view>
</view>
