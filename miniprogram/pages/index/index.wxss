/* 主页面样式 */
.title-section {
  text-align: center;
  padding: 40rpx 0 20rpx;
}
.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #FF6B81;
  display: block;
}
.subtitle {
  font-size: 26rpx;
  color: #BBB;
  margin-top: 8rpx;
  display: block;
}

/* 动画点 */
.dot {
  font-size: 36rpx;
  color: #FF6B81;
  margin: 0 8rpx;
  animation: blink 1.4s infinite;
  display: inline-block;
}
.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes blink {
  0%, 80%, 100% { opacity: 0.2; }
  40% { opacity: 1; }
}

/* 上传区域 */
.upload-section {
  width: 100%;
  margin-top: 32rpx;
}

.upload-divider {
  display: flex;
  align-items: center;
  margin: 20rpx 0 28rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #E8E8E8;
}

.divider-text {
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #CCC;
}

.upload-btns {
  display: flex;
  gap: 24rpx;
}

.upload-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0;
  border: 2rpx dashed #FFB8C6;
  border-radius: 20rpx;
  background: #FFF8F9;
  transition: all 0.15s ease;
}

.upload-btn:active {
  background: #FFF0F2;
  border-color: #FF6B81;
}

.upload-icon {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}

.upload-label {
  font-size: 24rpx;
  color: #FF6B81;
}